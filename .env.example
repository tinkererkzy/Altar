# Google Gemini API Anahtarınız (İsteğe Bağlı - Bulut Modeli Kullanımı İçin)
# Altar yerel Ollama motoru ile %100 çevrimdışı ve ücretsiz çalışabilir.
GEMINI_API_KEY="your_gemini_api_key_here"

# Çok makineli Ollama worker'ları (isteğe bağlı). Boş bırakıldığında yalnızca
# http://localhost:11434 kullanılır; hostları virgülle ayırın.
# ALTAR_OLLAMA_HOSTS="http://192.168.1.41:11434,http://192.168.1.42:11434"
# ALTAR_OLLAMA_CONNECT_TIMEOUT="10"
# ALTAR_OLLAMA_READ_TIMEOUT="180"
